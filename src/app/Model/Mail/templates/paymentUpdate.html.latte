{layout '@layout.html.latte'}
{varType array $reservation}
{varType array $settings}
{varType string $account}
{varType string $link}
{varType int $paid}
{varType int $remaining}
{varType bool $complete}

{block content}
<p>Dobrý den,</p>
{if $complete}
	<p>platbu za rezervaci č. <strong>{$reservation['id']}</strong> jsme přijali, děkujeme. Vaše lístky jsou zaplacené.</p>
	<p>Kdy: <strong>{$settings['event_date'] ?? ''}</strong><br>Kde: <strong>{$settings['venue'] ?? ''}</strong></p>
	<p>Lístky se netisknou – na vstupu vás najdeme na seznamu hostů.</p>
{else}
	<p>k rezervaci č. <strong>{$reservation['id']}</strong> jsme přijali platbu, celkem zatím <strong>{$paid|price}</strong>
		z <strong>{(int) $reservation['total_price']|price}</strong>.</p>
	<p>Doplaťte prosím <strong>{$remaining|price}</strong> na účet <strong>{$account}</strong>
		s variabilním symbolem <strong>{$reservation['variable_symbol']}</strong>. QR kód pro doplatek najdete u rezervace.</p>
{/if}
{/block}
