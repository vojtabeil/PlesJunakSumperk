{templateType App\Presentation\Front\Home\HomeTemplate}

{* "Koupit lístky" shows the whole map with the tickets without a seat on one screen. *}
{block headerAction}
	<a n:if="$canBuy" class="pill pill--paper header-action" href="#seat-picker" data-scroll-to="seat-picker">Koupit lístky</a>
{/block}

{block heroAction}
	<a n:if="$canBuy" class="pill pill--yellow hero-action" href="#seat-picker" data-scroll-to="seat-picker">Koupit lístky</a>
{/block}

{block content}
<p n:if="$preview" class="message">Náhled stránky ve stavu „{$preview->label()}“ – vidíte ji jen vy jako přihlášený organizátor.</p>

{* Written in HTML by the organizers in the administration (Nastavení → Stav webu). *}
<section n:if="!$canBuy" class="panel site-page">{$pageHtml|noescape}</section>

<section n:if="$canBuy" class="reservation" aria-labelledby="reservation-title">
	<h2 id="reservation-title">Rezervace lístků</h2>

	{* Replaced by the Preact seat picker; without JavaScript the static plan stays visible. *}
	<div id="seat-picker">
		<noscript><p class="message message--error">Rezervace vyžaduje zapnutý JavaScript.</p></noscript>
		<img n:if="$planUrl" class="map-static" src="{$planUrl}" alt="Plánek sálu">
	</div>
	<script type="application/json" id="seat-picker-data">{$pickerData|noescape}</script>
</section>
{/block}

{block scripts}
<script n:if="$canBuy" src="{$basePath}/{asset('build/front.js')}" type="module"></script>
{/block}
