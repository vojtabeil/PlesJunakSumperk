{templateType App\Presentation\Front\BaseTemplate}
{var $eventName = $settings['event_name'] ?? 'Skautský ples'}
{var $lastSpace = mb_strrpos($eventName, ' ')}
<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="theme-color" content="#2d4b8a">
	<title>{ifset title}{include title|stripHtml} – {/ifset}{$eventName}</title>
	<link rel="icon" type="image/svg+xml" href="{$basePath}/img/icons/organizer.svg">
	<link rel="preload" href="{$basePath}/fonts/skaut/skaut-bold-webfont.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="{$basePath}/fonts/skaut/TheMix_LT_400.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="stylesheet" href="{$basePath}/{asset('build/front.css')}">
</head>
<body>
<header class="site-header">
	<div class="site-bar">
		<a class="brand" href="{plink :Front:Home:default}"><span class="brand-mark" aria-hidden="true"></span><span>{$eventName}</span></a>
		{* Filled by the reservation page while tickets can be bought. *}
		{block headerAction}{/block}
	</div>

	<div class="hero">
		<div class="hero-text">
			<h1 class="hero-title">
				{if $lastSpace === false}{$eventName}{else}{mb_substr($eventName, 0, $lastSpace)} <span class="hero-accent">{mb_substr($eventName, $lastSpace + 1)}</span>{/if}
			</h1>
			<p n:if="!empty($settings['event_intro'])" class="hero-intro">{$settings['event_intro']}</p>
			{block heroAction}{/block}
		</div>

		{* Facts of the event as round badges sewn on a uniform. *}
		<ul n:if="$siteMode !== \App\Model\Site\SiteMode::After" class="badges">
			<li n:if="!empty($settings['venue'])" class="badge badge--paper">
				<span class="badge-label">Kde</span>
				<a n:tag-if="!empty($settings['venue_url'])" class="badge-value" href="{$settings['venue_url'] ?? ''}" target="_blank" rel="noopener">{$settings['venue']}</a>
			</li>
			<li n:if="!empty($settings['event_date'])" class="badge badge--yellow">
				<span class="badge-label">Kdy</span>
				<span class="badge-value">{$settings['event_date']}</span>
			</li>
			<li n:if="!empty($settings['band'])" class="badge badge--orange">
				<span class="badge-label">Hraje</span>
				<a n:tag-if="!empty($settings['band_url'])" class="badge-value" href="{$settings['band_url'] ?? ''}" target="_blank" rel="noopener">{$settings['band']}</a>
			</li>
			<li n:if="!empty($settings['organizer'])" class="badge badge--paper">
				<span class="badge-label">Pořádá</span>
				<span class="badge-value">{$settings['organizer']}</span>
			</li>
		</ul>
	</div>
</header>

<main class="page">
	{include content}
</main>

<footer class="site-footer">
	<p n:if="!empty($settings['contact_email']) || !empty($settings['contact_phone'])">
		Dotazy k plesu a vstupenkám:
		<a n:if="!empty($settings['contact_email'])" href="mailto:{$settings['contact_email']}">{$settings['contact_email']}</a>
		{if !empty($settings['contact_email']) && !empty($settings['contact_phone'])}·{/if}
		<a n:if="!empty($settings['contact_phone'])" href="tel:{str_replace(' ', '', $settings['contact_phone'])}">{$settings['contact_phone']}</a>
	</p>
	<p class="site-footer-org">
		<a href="https://www.skaut.cz/" target="_blank" rel="noopener"><img src="{$basePath}/img/skaut-logo.svg" alt="SKAUT – Junák – český skaut" width="170" height="48"></a>
		<span>Junák – český skaut, Šumperk</span>
	</p>
</footer>
{block scripts}{/block}
</body>
</html>
