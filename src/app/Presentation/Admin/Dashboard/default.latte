{templateType App\Presentation\Admin\Dashboard\DashboardTemplate}

{block title}Přehled{/block}

{block content}
{var $problems = $paymentProblems + array_sum($reservationProblems) + ($importOverdue ? 1 : 0) + ($hasPlan ? 0 : 1)}

<div class="page-head">
	<h1>Přehled</h1>
	{* Days to the ball (the stage of the site is in Stav webu). *}
	<p class="status-line">
		<span n:if="$eventCountdown" class="event-countdown">{$eventCountdown}</span>
		<a n:if="!$eventCountdown" n:href="Settings:default" class="event-countdown">Nastavte datum plesu</a>
	</p>
</div>

<div class="overview">
	{* 1. The three kinds of tickets as stacked bars, darker = further along *}
	<section class="card tickets-card" aria-labelledby="tickets-title">
		{include '../Accessory/ticketBars.latte', bars: $bars, entrance: $entrance, seatsUnavailable: $seatsUnavailable, seatFilter: $seatFilter}

		<p class="muted">
			Zaplaceno {$stats['paid_amount']|price} · čeká na platbu {$stats['unpaid_amount']|price} ·
			<a n:href="Check:default">Kontrola vstupenek</a>
		</p>
	</section>

	{* What needs attention *}
	<section class="card todo-card" aria-labelledby="todo-title">
		<h2 id="todo-title">Co je potřeba udělat</h2>
		<ul class="todo">
			<li n:if="!$hasPlan">
				<a n:href="Danger:plan">Nahrajte plánek sálu</a>
				<span class="muted">bez něj nejde prodávat místa u stolů</span>
			</li>
			<li n:if="$paymentProblems">
				<a n:href="Payment:default, filter: problems">Platby k vyřešení: <strong>{$paymentProblems}</strong></a>
				<span class="muted">bez VS, neznámý VS, nedoplatek nebo přeplatek</span>
			</li>
			<li n:if="$reservationProblems['email']">
				<a n:href="Reservation:default, problem: email">Neodeslané potvrzovací e-maily: <strong>{$reservationProblems['email']}</strong></a>
			</li>
			<li n:if="$reservationProblems['overdue']">
				<a n:href="Reservation:default, problem: overdue">Nezaplacené po splatnosti: <strong>{$reservationProblems['overdue']}</strong></a>
				{if $toRemind}
					<span class="muted">Připomínku zatím nedostalo: {$toRemind}</span>
					{control remindForm}
				{else}
					<span class="muted">Všichni už připomínku dostali.</span>
				{/if}
			</li>
			<li n:if="$reservationProblems['refund']">
				<a n:href="Reservation:default, problem: refund">K vrácení peněz: <strong>{$reservationProblems['refund']}</strong></a>
				<span class="muted">celkem {$refundTotal|hellers}; vrácení zapíšete v detailu rezervace</span>
			</li>
			<li n:if="$importOverdue">Platby se déle než den nenačítaly a rezervace čekají na platbu.</li>
		</ul>
		<p n:if="!$problems" class="all-good">Vše v pořádku.</p>
		<div class="import-line">
			<span class="muted">Platby z banky naposledy načteny {if $lastImportAt}{$lastImportAt|date:'j. n. H:i'}{else}zatím nikdy{/if}.</span>
			{control importForm}
		</div>
	</section>
</div>

{* 2. The latest reservations; the full list with filters and sorting is one click away *}
<section class="card" aria-labelledby="latest-title">
	<div class="page-head">
		<h2 id="latest-title"><a n:href="Reservation:default">Poslední rezervace</a></h2>
		<a n:href="Reservation:default">Všechny rezervace ({$stats['confirmed'] + $stats['partially_paid'] + $stats['paid'] + $stats['cancelled']}) →</a>
	</div>
	{include '../Reservation/table.latte', reservations: $latestReservations}
</section>

{* 3. Full lists of the three kinds of tickets, folded *}
<section class="card ticket-lists" aria-labelledby="ticket-lists-title">
	<h2 id="ticket-lists-title">Seznamy lístků</h2>

	<details class="seat-details">
		<summary>Lístky na místo ({count($ticketLists['seat'])})</summary>
		<div class="table-scroll">
			<table class="data-table data-table--cards">
				<thead><tr><th scope="col">Místo</th><th scope="col">Rezervace</th><th scope="col">Stav</th><th scope="col">Kód</th><th scope="col">Vstup</th></tr></thead>
				<tbody>
					<tr n:foreach="$ticketLists['seat'] as $t">
						<td data-label="Místo"><strong>{$t['seat_label']|seatLabel|firstUpper}</strong></td>
						<td data-label="Rezervace">{include reservationLink, t: $t}</td>
						<td data-label="Stav"><span class="badge badge--{$t['status']}">{$t['status']|statusLabel}</span></td>
						<td data-label="Kód"><span class="ticket-code">{$t['code']}</span></td>
						<td data-label="Vstup">{if $t['used_at']}{$t['used_at']|date:'j. n. H:i'}{else}–{/if}</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p n:if="!$ticketLists['seat']" class="empty"><strong>Zatím žádné lístky na místo.</strong></p>
	</details>

	<details class="seat-details">
		<summary>Lístky na stání ({count($ticketLists['standing'])})</summary>
		<div class="table-scroll">
			<table class="data-table data-table--cards">
				<thead><tr><th scope="col">Rezervace</th><th scope="col">Stav</th><th scope="col">Kód</th><th scope="col">Vstup</th></tr></thead>
				<tbody>
					<tr n:foreach="$ticketLists['standing'] as $t">
						<td data-label="Rezervace">{include reservationLink, t: $t}</td>
						<td data-label="Stav"><span class="badge badge--{$t['status']}">{$t['status']|statusLabel}</span></td>
						<td data-label="Kód"><span class="ticket-code">{$t['code']}</span></td>
						<td data-label="Vstup">{if $t['used_at']}{$t['used_at']|date:'j. n. H:i'}{else}–{/if}</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p n:if="!$ticketLists['standing']" class="empty"><strong>Zatím žádné lístky na stání.</strong></p>
	</details>

	<details class="seat-details">
		<summary>Z-lístky ({count($ticketLists['crew'])})</summary>
		<div class="table-scroll">
			<table class="data-table data-table--cards">
				<thead><tr><th scope="col">Jméno</th><th scope="col">Funkce</th><th scope="col">Vyzvednuto</th><th scope="col">Kód</th><th scope="col">Vstup</th></tr></thead>
				<tbody>
					<tr n:foreach="$ticketLists['crew'] as $t">
						<td data-label="Jméno"><a n:href="Crew:edit $t['crew_member_id']">{$t['name']}</a></td>
						<td data-label="Funkce">{$t['role']}</td>
						<td data-label="Vyzvednuto">{if $t['picked_up_at']}{$t['picked_up_at']|date:'j. n. H:i'}{else}–{/if}</td>
						<td data-label="Kód"><span class="ticket-code">{$t['code']}</span></td>
						<td data-label="Vstup">{if $t['used_at']}{$t['used_at']|date:'j. n. H:i'}{else}–{/if}</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p n:if="!$ticketLists['crew']" class="empty"><strong>Zatím žádné Z-lístky.</strong> <a n:href="Crew:add">Přidat</a></p>
	</details>
</section>

{define reservationLink}
	<a n:href="Reservation:detail $t['reservation_id']">č. {$t['reservation_id']} {$t['name']}</a>
	{include '../Accessory/channelBadge.latte', channel: $t['channel']}
{/define}

{* 4. Table of all seats *}
<section class="card" aria-labelledby="seats-title">
<details id="seat-table" class="seat-details" n:attr="open: $seatFilter || $presenter->seatSearch">
	<summary>Tabulka všech míst ({$seatTotal}){if $seatFilter} – {$seatFilter|seatStatus}{/if}</summary>
	<div class="page-head">
		<h2 id="seats-title">Všechna místa{if $seatFilter} – {$seatFilter|seatStatus}{/if}</h2>
		<form class="filter-form" method="get" action="{link this}">
			<input type="hidden" name="seats" value="{$seatFilter}">
			<label>Hledat <input type="search" name="seatSearch" value="{$presenter->seatSearch}" placeholder="místo (A1/5) nebo jméno"></label>
			<button class="button">Hledat</button>
			<a n:if="$seatFilter || $presenter->seatSearch" n:href="this, seats: '', seatSearch: ''">zrušit filtr</a>
		</form>
	</div>
	<div class="table-scroll">
		<table class="data-table data-table--cards">
			<thead>
				<tr><th scope="col">Místo</th><th scope="col">Stav</th><th scope="col">Rezervace</th><th scope="col">Poslední změna</th></tr>
			</thead>
			<tbody>
				<tr n:foreach="$seatRows as $seat">
					<td data-label="Místo"><strong>{$seat['label']}</strong> <span class="muted">stůl {$seat['table']}</span></td>
					<td data-label="Stav"><span class="badge badge--seat-{$seat['status']}">{$seat['status']|seatStatus}</span>
						<span n:if="!$seat['table_available'] && $seat['status'] !== 'unavailable'" class="muted">stůl mimo prodej</span></td>
					<td data-label="Rezervace">
						{if $seat['reservation_id']}
							<a n:href="Reservation:detail $seat['reservation_id']">č. {$seat['reservation_id']} {$seat['name']}</a>
							{include '../Accessory/channelBadge.latte', channel: $seat['channel']}
						{else}–{/if}
					</td>
					<td data-label="Poslední změna">
						{if $seat['changed_at']}{$seat['changed_at']|date:'j. n. Y H:i'}{else}–{/if}
						<a n:href="Log:default, seat: $seat['label']" class="muted">historie</a>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
	<p n:if="!$seatRows" class="empty"><strong>Žádná místa neodpovídají filtru.</strong> <a n:href="this, seats: '', seatSearch: ''">Zobrazit všechna místa</a></p>
</details>
</section>
{* Narrower screens have no room for the rail of other applications at the right edge: the same links here. *}
{include '../Accessory/apps.latte', apps: $apps, variant: inline}


{* 5. Other sections *}
<nav class="tiles" aria-label="Další části administrace">
	<a class="tile" n:href="Reservation:default"><strong>Rezervace</strong><span>seznam s filtry a řazením, detail a zásahy</span></a>
	<a class="tile" n:href="Customer:default"><strong>Zákazníci</strong><span>lidé podle e-mailu a jejich rezervace</span></a>
	<a class="tile" n:href="Payment:default"><strong>Platby z Fio</strong><span>všechny platby, spárované i k vyřešení</span></a>
	<a class="tile" n:href="Crew:default"><strong>Z-lístky</strong><span>vstup zdarma pro tým: přidat, vytisknout, poslat e-mailem</span></a>
	<a class="tile" n:href="Check:default"><strong>Kontrola vstupenek</strong><span>aplikace pro telefon u vchodu, funguje i offline</span></a>
	<a class="tile" n:href="Export:guests"><strong>Seznam hostů</strong><span>CSV pro vstup (Excel)</span></a>
	<a class="tile" n:href="Site:default"><strong>Stav webu</strong><span>testování, VIP, prodej, konec; odkazy a texty stránek</span></a>
	<a class="tile" n:href="Tables:default"><strong>Stoly v prodeji</strong><span>které stoly jsou v plánku k prodeji</span></a>
	<a class="tile" n:href="Settings:default"><strong>Nastavení</strong><span>akce, ceny, limity, platby</span></a>
	<a class="tile" n:href="Statistics:default"><strong>Statistiky</strong><span>prodej po dnech, tržby, obsazenost; data v CSV</span></a>
	<a class="tile" n:href="Log:default"><strong>Log</strong><span>všechny události, filtr podle data, místa a typu</span></a>
</nav>
{/block}
