{templateType App\Presentation\Admin\BaseTemplate}
<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="robots" content="noindex">
	<title>{ifset title}{include title|stripHtml} – {/ifset}Administrace plesu</title>
	<link rel="icon" type="image/svg+xml" href="{$basePath}/img/icons/organizer.svg">
	<link rel="stylesheet" href="{$basePath}/{asset('build/admin.css')}">
</head>
<body>
<header class="admin-header">
	<a class="admin-brand" n:href="Dashboard:default">Administrace plesu</a>
	{if $user->isLoggedIn()}
		{* Settings = the section with its own tabs (Accessory/settingsTabs.latte): event and prices, tables for sale, dangerous zone. *}
		{var $inSettings = $presenter->isLinkCurrent('Settings:*') || $presenter->isLinkCurrent('Tables:*') || $presenter->isLinkCurrent('Danger:*')}
		<nav class="admin-nav" aria-label="Hlavní menu">
			<a n:href="Dashboard:default" n:class="$presenter->isLinkCurrent('Dashboard:*') ? 'is-current'">Přehled</a>
			<a n:href="Reservation:default" n:class="$presenter->isLinkCurrent('Reservation:*') ? 'is-current'">Rezervace</a>
			<a n:href="Customer:default" n:class="$presenter->isLinkCurrent('Customer:*') ? 'is-current'">Zákazníci</a>
			<a n:href="Payment:default" n:class="$presenter->isLinkCurrent('Payment:*') ? 'is-current'">Platby</a>
			<a n:href="Crew:default" n:class="$presenter->isLinkCurrent('Crew:*') ? 'is-current'">Z-lístky</a>
			<a n:href="Site:default" n:class="$presenter->isLinkCurrent('Site:*') ? 'is-current'">Stav webu</a>
			<a n:href="Settings:default" n:class="$inSettings ? 'is-current'">Nastavení</a>
			<a n:href="Log:default" n:class="$presenter->isLinkCurrent('Log:*') ? 'is-current'">Log</a>
		</nav>
		<form class="admin-search" method="get" action="{plink Search:default}" role="search">
			<label for="admin-search" class="visually-hidden">Hledat</label>
			<input id="admin-search" type="search" name="q" placeholder="Hledat: jméno, e-mail, č. rezervace, VS, místo A1/5">
		</form>
		{* Only the account: the other sections are in the menu, the dashboard and the settings tabs. *}
		{* Phones: the whole menu and the account behind the hamburger (admin-nav and admin-user are hidden there). *}
		<details class="admin-burger">
			<summary aria-label="Menu"><span class="admin-burger-icon" aria-hidden="true"></span></summary>
			<nav class="admin-burger-menu" aria-label="Menu">
				<a n:href="Dashboard:default" n:class="$presenter->isLinkCurrent('Dashboard:*') ? 'is-current'">Přehled</a>
				<a n:href="Reservation:default" n:class="$presenter->isLinkCurrent('Reservation:*') ? 'is-current'">Rezervace</a>
				<a n:href="Customer:default" n:class="$presenter->isLinkCurrent('Customer:*') ? 'is-current'">Zákazníci</a>
				<a n:href="Payment:default" n:class="$presenter->isLinkCurrent('Payment:*') ? 'is-current'">Platby</a>
				<a n:href="Crew:default" n:class="$presenter->isLinkCurrent('Crew:*') ? 'is-current'">Z-lístky</a>
				<a n:href="Check:default">Kontrola vstupenek</a>
				<a n:href="Site:default" n:class="$presenter->isLinkCurrent('Site:*') ? 'is-current'">Stav webu</a>
				<a n:href="Settings:default" n:class="$inSettings ? 'is-current'">Nastavení</a>
				<a n:href="Log:default" n:class="$presenter->isLinkCurrent('Log:*') ? 'is-current'">Log</a>
				<span class="admin-burger-account">{$adminName}</span>
				<a n:href="Account:default" n:class="$presenter->isLinkCurrent('Account:*') ? 'is-current'">Změnit heslo</a>
				<a n:href="User:default" n:class="$presenter->isLinkCurrent('User:*') ? 'is-current'">Administrátoři</a>
				<a n:href="Sign:out">Odhlásit</a>
			</nav>
		</details>
		<details class="admin-user">
			<summary>{$adminName}</summary>
			<div class="admin-user-menu">
				<a n:href="Account:default">Změnit heslo</a>
				<a n:href="User:default">Administrátoři</a>
				<a n:href="Sign:out">Odhlásit</a>
			</div>
		</details>
	{/if}
</header>

<main class="admin-main">
	<div n:foreach="$flashes as $flash" class="flash flash--{$flash->type}" role="status">{$flash->message}</div>
	{include content}
</main>
<script src="{$basePath}/{asset('build/admin.js')}" type="module"></script>
</body>
</html>
