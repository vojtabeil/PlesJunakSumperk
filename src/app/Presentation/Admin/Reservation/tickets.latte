{templateType App\Presentation\Admin\Reservation\ReservationTemplate}
{layout none}
{var $r = $reservation}
{var $remaining = max(0, (int) $r['total_price'] - (int) round((float) $r['paid_amount']))}
<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="robots" content="noindex">
	<title>Vstupenky – rezervace č. {$r['id']}</title>
	<link rel="stylesheet" href="{$basePath}/{asset('build/admin.css')}">
</head>
<body class="crew-print">
<div class="crew-print-bar">
	<a n:href="detail $r['id']">← Zpět na rezervaci č. {$r['id']}</a>
	<button type="button" class="button" onclick="print()">Vytisknout ({count($printTickets)})</button>
</div>
<p n:if="$revealReason !== null" class="unpaid-note">
	<strong>Rezervace není zaplacená</strong> (zbývá {$remaining|price}). Vstupenky zobrazuje {$adminName}, důvod: {$revealReason}.
	Zobrazení je zapsané v logu.
</p>
<div class="crew-cards">
	<article n:foreach="$printTickets as $i => $ticket" class="crew-card">
		<div class="crew-card-text">
			<p class="crew-card-kicker">Vstupenka</p>
			<h2>{$settings['event_name'] ?? 'Skautský ples'}</h2>
			<p class="crew-card-event">{$settings['event_date'] ?? ''}{if !empty($settings['venue'])} · {$settings['venue']}{/if}</p>
			<p class="crew-card-name">{if $ticket['seat_label'] !== null}{$ticket['seat_label']|seatLabel|firstUpper}{else}Bez místenky (na stání){/if}</p>
			<p class="crew-card-role">{$r['name']} · rezervace č. {$r['id']}</p>
			<p n:if="$revealReason !== null" class="crew-card-unpaid">Nezaplaceno – u vstupu doplatit {$remaining|price}</p>
		</div>
		<div class="crew-card-code">
			<img src="{$qrCodes[$i]|nocheck}" alt="QR kód {$ticket['code']}" width="110" height="110">
			<strong>{$ticket['code']}</strong>
		</div>
	</article>
</div>
</body>
</html>
