{templateType App\Presentation\Admin\Reservation\ReservationTemplate}

{block title}Rezervace č. {$reservation['id']}{/block}

{block content}
{var $r = $reservation}
{var $open = in_array($r['status'], ['confirmed', 'partially_paid'], true)}
{var $remaining = (int) $r['total_price'] - (int) $r['paid_amount']}
<p><a n:href="default">← Zpět na seznam</a></p>
<div class="page-head">
	<h1>Rezervace č. {$r['id']} <span class="muted">{$r['name']}</span></h1>
	<p class="status-line">
		<span class="badge badge--{$r['status']}">{$r['status']|statusLabel}</span>
		<span n:if="$overdueDays" class="badge badge--overdue">po splatnosti {$overdueDays} {$overdueDays === 1 ? 'den' : ($overdueDays < 5 ? 'dny' : 'dní')}</span>
		{include '../Accessory/channelBadge.latte', channel: $r['channel']}
	</p>
</div>

{* One sentence that says what is going on and what to do. *}
<p n:class="'flash', $open ? 'flash--info'">
	{if $r['status'] === 'paid'}
		Zaplaceno {(int) $r['paid_amount']|price}{if $r['paid_at']} dne {$r['paid_at']|date:'j. n. Y'}{/if}. Není potřeba nic dělat.
	{elseif $open}
		Čeká na platbu {$remaining|price} na VS <strong>{$r['variable_symbol']}</strong>{if (int) $r['paid_amount'] > 0} (už zaplaceno {(int) $r['paid_amount']|price}){/if}{if $dueOn}, splatnost {$dueOn|date:'j. n. Y'}{if $dueOn < new \DateTimeImmutable('today')} – <strong>po splatnosti</strong>{/if}{/if}.
		{if $r['reminded_at']}Připomínka odeslána {$r['reminded_at']|date:'j. n. Y H:i'}.{/if}
		Platba z banky se spáruje sama; zaplatil-li host hotově, označte rezervaci jako zaplacenou.
	{elseif $r['status'] === 'cancelled'}
		Rezervace je zrušená, její místa jsou volná.{if $refundDue} Zákazníkovi je potřeba vrátit <strong>{$refundDue|hellers}</strong> (níže Vrácení peněz).{/if}
	{else}
		Host rezervaci ještě nedokončil (vybírá místa).
	{/if}
	<span n:if="!$r['email_sent_at'] && $r['status'] !== 'draft' && $r['status'] !== 'cancelled'" class="error-text">
		Potvrzovací e-mail nebyl odeslán{if $r['email_error']} ({$r['email_error']}){/if}.
	</span>
</p>

<div class="columns">
	<section class="card">
		<h2>Údaje</h2>
		<dl class="details">
			<dt>Jméno</dt><dd>{$r['name'] ?? '–'}</dd>
			<dt>E-mail</dt><dd><a href="mailto:{$r['email']}">{$r['email']}</a> · <a n:href="Customer:default, q: $r['email']">všechny rezervace</a></dd>
			<dt>Telefon</dt><dd>{if $r['phone']}<a href="tel:{str_replace(' ', '', $r['phone'])}">{$r['phone']}</a>{else}–{/if}</dd>
			<dt>Místa</dt>
			<dd>
				{foreach $r['seats'] as $label}
					<a n:href="Log:default, seat: $label, reservation: ''" title="Historie místa">{$label|seatLabel}</a>{sep}; {/sep}
				{else}–{/foreach}
			</dd>
			<dt>Bez místenky</dt><dd>{$r['standing_tickets']}</dd>
			<dt>Cena</dt><dd>{(int) $r['total_price']|price}</dd>
			<dt>Zaplaceno</dt><dd>{(int) $r['paid_amount']|price}</dd>
			<dt>Variabilní symbol</dt><dd>{$r['variable_symbol']}</dd>
			<dt>Potvrzeno</dt><dd>{if $r['confirmed_at']}{$r['confirmed_at']|date:'j. n. Y H:i'}{else}–{/if}</dd>
			<dt n:if="$dueOn && $open">Splatnost</dt>
			<dd n:if="$dueOn && $open">{$dueOn|date:'j. n. Y'}{if $overdueDays} <strong class="error-text">po splatnosti</strong>{/if}</dd>
			<dt>Připomínka platby</dt><dd>{if $r['reminded_at']}odeslána {$r['reminded_at']|date:'j. n. Y H:i'}{else}–{/if}</dd>
			<dt>Stránka zákazníka</dt>
			<dd>{if $customerLink}<a href="{$customerLink}" target="_blank">Moje rezervace</a> <span class="muted">(stejný odkaz má zákazník v e-mailu)</span>{else}–{/if}</dd>
			<dt>Potvrzovací e-mail</dt>
			<dd>{if $r['email_sent_at']}odeslán {$r['email_sent_at']|date:'j. n. Y H:i'}{else}neodeslán{/if}</dd>
		</dl>
	</section>

	<section class="card actions-card">
		<h2>Co můžete udělat</h2>
		<p class="contact-actions">
			<a n:if="$r['phone']" class="button" href="tel:{str_replace(' ', '', $r['phone'])}">Zavolat</a>
			<a n:if="$r['email']" class="button" href="mailto:{$r['email']}?subject={rawurlencode('Rezervace č. ' . $r['id'] . ' – ' . $eventName)}">Napsat e-mail</a>
		</p>
		<div class="actions">
			{if $open}{control markPaidForm}{/if}
			{if $open && $r['email_sent_at']}{control remindForm}{/if}
			{if $r['status'] === 'paid' && $tickets}{control sendTicketsForm}{/if}
			{if $r['status'] !== 'draft' && $r['status'] !== 'cancelled'}{control resendForm}{/if}
			{if $r['status'] !== 'cancelled'}
				<div class="danger-zone">{control cancelForm}</div>
			{/if}
		</div>
		{control noteForm}
	</section>
</div>

<section class="card refund-card" n:if="$refundDue || $refunds" aria-labelledby="refund-title">
	<div class="page-head">
		<h2 id="refund-title">Vrácení peněz</h2>
		<p class="status-line">{if $refundDue}<strong class="error-text">K vrácení {$refundDue|hellers}</strong>{else}<span class="badge badge--paid">vše vráceno</span>{/if}</p>
	</div>
	<p n:if="$refundDue" class="muted">
		{if $r['status'] === 'cancelled'}Rezervace je zrušená: vrací se vše zaplacené.{else}Zaplaceno víc, než je cena rezervace: vrací se přeplatek.{/if}
		{if $refundAccounts}Platil z účtu {implode(', ', $refundAccounts)}.{/if}
		Peníze pošlete z účtu střediska (nebo vraťte hotově) a pak vrácení zapište.
	</p>
	<ul class="activity" n:if="$refunds">
		<li n:foreach="$refunds as $refund">
			<time>{$refund['refunded_on']|date:'j. n. Y'}</time>
			<strong>{$refund['amount']|hellers}</strong> {\App\Model\Payment\Refunds::Methods[$refund['method']] ?? $refund['method']}
			{if $refund['note']} – {$refund['note']}{/if}
			<span class="muted">({$refund['created_by'] ?? 'neznámý'})</span>
			{var $deleteForm = 'deleteRefund-' . $refund['id']}
			<form n:name="$deleteForm" class="inline-form"><button n:name="delete" class="link-button">smazat zápis</button></form>
		</li>
	</ul>
	{if $refundDue}{control refundForm}{/if}
</section>

<section class="card" n:if="$tickets">
	<div class="page-head">
		<h2>Vstupenky</h2>
		<a n:href="Check:default">kontrola vstupenek</a>
	</div>
	<p n:if="in_array($r['status'], \App\Model\Ticket\UnpaidTickets::UnpaidStatuses, true)" class="muted">
		Rezervace není zaplacená: host vstupenky (QR kódy) neuvidí a dostane je e-mailem až po zaplacení.
		Přihlášený organizátor je může otevřít odkazem a vytisknout s důvodem, který se na vstupenku vytiskne červeně.
	</p>
	<ul class="activity">
		<li n:foreach="$tickets as $ticket">
			<strong class="ticket-code">{$ticket['code']}</strong>
			{if $ticket['seat_label'] !== null}{$ticket['seat_label']|seatLabel}{else}bez místenky{/if}
			–
			{if $ticket['used_at']}
				<strong>vstup {$ticket['used_at']|date:'j. n. Y H:i'}</strong>{if $ticket['used_by_name']} ({$ticket['used_by_name']}){/if}
			{else}nepoužita{/if}
			· <a href="{$ticket['print_link']}" target="_blank">k vytištění</a>
		</li>
	</ul>
</section>

<section class="card">
	<h2>Platby z banky</h2>
	<ul class="activity" n:if="$payments">
		<li n:foreach="$payments as $p">
			<time>{$p['booked_on']|date:'j. n. Y'}</time>
			{number_format((float) $p['amount'], 2, ',', ' ')} Kč – {$p['counter_name'] ?? '?'}
			<span class="muted">({$p['match_status']|matchLabel})</span>
		</li>
	</ul>
	<p n:if="!$payments" class="muted">Zatím žádná platba z banky. Platbu bez VS přiřadíte na stránce <a n:href="Payment:default, filter: problems">Platby</a>.</p>
</section>

<section class="card">
	<div class="page-head">
		<h2>Historie</h2>
		<a n:href="Log:default, reservation: (string) $r['id'], seat: ''">celý log rezervace</a>
	</div>
	<ul class="activity" n:if="$activity">
		<li n:foreach="$activity as $entry">
			<time>{$entry['created_at']|date:'j. n. Y H:i'}</time>
			<strong>{$entry['action']|eventLabel}</strong>
			{var $details = ($entry|eventDetails)}
			<span n:if="$details">– {$details}</span>
			<span class="muted">({$entry['admin_name'] ?? ($entry['actor_type']|actorLabel)})</span>
		</li>
	</ul>
	<p n:if="!$activity" class="muted">Zatím žádné události.</p>
</section>
{/block}
