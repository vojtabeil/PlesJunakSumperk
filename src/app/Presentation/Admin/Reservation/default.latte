{templateType App\Presentation\Admin\Reservation\ReservationTemplate}

{block title}Rezervace{/block}

{block content}
<div class="page-head">
	<h1>Rezervace</h1>
	<a class="button" n:href="Export:guests">Stáhnout seznam hostů (CSV)</a>
</div>

<form n:name="filterForm" class="filter-form">
	<label n:name="status">Stav <select n:name="status"></select></label>
	<label n:name="channel">Prodej <select n:name="channel"></select></label>
	<label n:name="sort">Řadit <select n:name="sort"></select></label>
	<label n:name="q">Hledat <input n:name="q"></label>
	<button n:name="filter" class="button">Filtrovat</button>
	<a n:if="$presenter->status || $presenter->channel || $presenter->q || $presenter->problem || $sort !== App\Model\Reservation\ReservationAdmin::DefaultSort"
		n:href="this, status: '', channel: '', q: '', problem: '', sort: null">zrušit filtr</a>
</form>

<p n:if="$problemLabel" class="flash flash--info">
	Zobrazeny jen rezervace: <strong>{$problemLabel}</strong> · <a n:href="this, problem: ''">zobrazit všechny</a>
</p>

<section class="card">
	<p class="muted">Počet: {count($reservations)}</p>
	{include 'table.latte', reservations: $reservations, sort: $sort}
</section>
{/block}
