{templateType App\Presentation\Admin\Check\CheckTemplate}
<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
	<meta name="robots" content="noindex">
	<meta name="theme-color" content="#2d4b8a">
	<title>Kontrola vstupenek</title>
	<link rel="icon" type="image/svg+xml" href="{$basePath}/img/icons/kontrola.svg">
	<link rel="apple-touch-icon" href="{$basePath}/img/icons/kontrola-192.png">
	<link rel="manifest" href="{$basePath}/kontrola.webmanifest">
	<link rel="stylesheet" href="{$basePath}/{asset('build/check.css')}">
</head>
<body>
<main class="check">
	<div id="check-app" class="check-app">
		<noscript><p class="check-card check-card--invalid">Kontrola vstupenek potřebuje zapnutý JavaScript.</p></noscript>
	</div>
</main>
<script type="application/json" id="check-data">{$data|noescape}</script>
<script src="{$basePath}/{asset('build/check.js')}" type="module"></script>
</body>
</html>
