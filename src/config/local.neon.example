# Machine-specific configuration. setup.cmd copies this file to config/local.neon (not committed).
# On Lebeda, fill in the credentials from the hosting administration.

parameters:
	database:
		host: 127.0.0.1
		port: 3307
		name: ples
		user: ples
		password: ples

	# Outgoing e-mail over SMTP. Locally everything goes to Mailpit (http://127.0.0.1:8025).
	# Production example (Seznam): host smtp.seznam.cz, port 465, secure ssl, user/password of the mailbox.
	mail:
		host: 127.0.0.1
		port: 1025
		secure: ''       # '', ssl (SMTPS) or tls (STARTTLS)
		user: ''         # empty = no SMTP authentication
		password: ''
		from: ples@junak-sumperk.cz
		fromName: Šumperský skautský ples
		replyTo: ''

	# Web of Mailpit, linked from the administration (debug mode only). Production: ''.
	mailpit: http://127.0.0.1:8025

	# Bank movements. mock = fake bank for testing (/dev/bank), fio = Fio API (production).
	# Production: driver: fio and the read-only token ("Sledování účtu") from Fio internet banking.
	bank:
		driver: mock
		token: ''

	# Automatic payment import: GET https://<site>/cron/payments every 10 minutes with the header
	# "X-Cron-Key: <key>" (not ?key= in the URL, it would end up in logs). At least 32 random letters and digits;
	# empty or shorter = disabled.
	cron:
		key: ''

	# Password of the first-run wizard (/admin/setup), used only while no administrator exists.
	# Change it on the hosting before uploading.
	setup:
		password: skaut-sumperk
