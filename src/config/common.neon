# Shared configuration. Secrets and machine-specific values belong to config/local.neon.

parameters:
	# Overridden in local.neon.
	database: []
	mail: []
	bank:
		driver: mock   # mock = fake bank for local testing (/dev/bank), fio = Fio API
	setup:
		# Required by the first-run wizard (/admin/setup) while no administrator exists.
		password: skaut-sumperk
	cron:
		# Secret for GET /cron/payments?key=...; empty = the endpoint does not exist.
		key: ''
	# Web of the local e-mail catcher (Mailpit), linked from the administration in debug mode; '' = none.
	mailpit: ''


application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping: App\Presentation\*\**Presenter


latte:
	strictTypes: yes
	strictParsing: yes
	extensions:
		- App\Presentation\Accessory\TemplateExtension(%rootDir%/www)


# Czech defaults of the form validation messages (used where a rule has no message of its own).
forms:
	messages:
		Equal: 'Zadejte %s.'
		NotEqual: 'Tato hodnota nesmí být %s.'
		Filled: 'Vyplňte toto pole.'
		Blank: 'Toto pole musí zůstat prázdné.'
		MinLength: 'Zadejte aspoň %d znaků.'
		MaxLength: 'Zadejte nejvýše %d znaků.'
		Length: 'Zadejte %d až %d znaků.'
		Email: 'Zadejte platnou e-mailovou adresu.'
		URL: 'Zadejte platnou adresu (https://…).'
		Integer: 'Zadejte celé číslo.'
		Float: 'Zadejte číslo.'
		Min: 'Zadejte číslo nejméně %d.'
		Max: 'Zadejte číslo nejvýše %d.'
		Range: 'Zadejte číslo od %d do %d.'
		MaxFileSize: 'Soubor může mít nejvýše %d bajtů.'
		MaxPostSize: 'Odeslaná data jsou větší než povolených %d bajtů.'
		MimeType: 'Nahraný soubor nemá očekávaný formát.'
		Image: 'Nahraný soubor musí být obrázek JPEG, GIF, PNG nebo WebP.'
		Nette\Forms\Controls\SelectBox::Valid: 'Vyberte prosím platnou možnost.'
		Nette\Forms\Controls\UploadControl::Valid: 'Soubor se nepodařilo nahrát.'
		Nette\Forms\Controls\CsrfProtection::Protection: 'Platnost formuláře vypršela, odešlete ho prosím znovu.'


security:
	authentication:
		# Organizers are logged out after 2 hours of inactivity.
		expiration: 2 hours


session:
	name: ples_session
	cookieSamesite: Lax
	expiration: 7 days


di:
	export:
		parameters: no
		tags: no
