# Service definitions. Implementations of interfaces are chosen here (or overridden in local.neon).

services:
	- App\Core\RouterFactory::createRouter

	database: App\Model\Database\ConnectionFactory::create(%database%)

	- App\Model\Reservation\Settings
	- App\Model\Reservation\ReservationService
	- App\Model\Reservation\ReservationSession
	- App\Model\Reservation\ReservationAdmin

	- App\Model\Admin\AdminUsers
	- App\Model\Admin\Authenticator
	- App\Model\Admin\AuditLog

	- App\Model\Clock\SystemClock

	# Bank movements: mock bank locally, Fio API in production (parameter bank.driver).
	bankSource:
		type: App\Model\Payment\BankTransactionSource
		create: App\Model\Payment\BankSourceFactory::create(%bank%)
	- App\Model\Payment\Mock\MockBank
	- App\Model\Payment\PaymentMatcher
	- App\Model\Payment\PaymentImporter
	- App\Model\Payment\PaymentRepository
	- App\Model\Payment\QrPayment

	- App\Presentation\Accessory\FormFactory

	mailSender:
		type: App\Model\Mail\MailSender
		create: App\Model\Mail\SmtpMailSender(%mail%)
	- App\Model\Mail\ReservationMailer
