{templateType App\Presentation\Admin\Dashboard\DashboardTemplate}

{block title}Přehled{/block}

{block content}
<div class="page-head">
	<h1>Přehled</h1>
	<p n:class="'badge', $saleOpen ? 'badge--paid' : 'badge--cancelled'">
		Prodej {$saleOpen ? 'je otevřený' : 'je uzavřený'}
		· <a n:href="Settings:default">změnit</a>
	</p>
</div>

<section n:class="'card', 'import-card', $importOverdue ? 'import-card--overdue'" aria-label="Platby z banky">
	<div>
		<strong>Platby z banky</strong> –
		naposledy načteno {if $lastImportAt}{$lastImportAt|date:'j. n. Y H:i'}{else}zatím nikdy{/if}.
		<span n:if="$importOverdue">Rezervace čekají na platbu a platby se déle než den nenačítaly – načtěte je prosím.</span>
		<span n:if="!$importOverdue" class="muted">Bez automatického načítání (cron) je načtěte tlačítkem.</span>
	</div>
	{control importForm}
</section>

<section class="stats" aria-label="Souhrn">
	<div class="stat">
		<span class="stat-value">{$stats['reserved']} / {$stats['total']}</span>
		<span class="stat-label">rezervovaných míst</span>
		<span class="stat-note">volných {$stats['free']}{if $stats['held']}, právě vybíraných {$stats['held']}{/if}</span>
	</div>
	<div class="stat">
		<span class="stat-value">{$stats['standing']} / {$stats['standing_capacity']}</span>
		<span class="stat-label">lístků bez místenky</span>
	</div>
	<div class="stat">
		<span class="stat-value">{$stats['paid']}</span>
		<span class="stat-label">zaplacených rezervací</span>
		<span class="stat-note">{$stats['paid_amount']|price}</span>
	</div>
	<div class="stat stat--warning">
		<span class="stat-value">{$stats['confirmed']}</span>
		<span class="stat-label">čeká na platbu</span>
		<span class="stat-note">{$stats['unpaid_amount']|price}{if $stats['partially_paid']}, z toho částečně zaplaceno {$stats['partially_paid']}{/if}</span>
	</div>
	<a n:if="$paymentProblems" class="stat stat--problem" n:href="Payment:default, problems: true">
		<span class="stat-value">{$paymentProblems}</span>
		<span class="stat-label">plateb k vyřešení</span>
		<span class="stat-note">neznámý VS, nedoplatek, přeplatek</span>
	</a>
</section>

<div class="columns">
	<section class="card">
		<h2>Poslední rezervace</h2>
		{include '../Reservation/table.latte', reservations: $recentReservations}
		<p><a n:href="Reservation:default">Všechny rezervace →</a></p>
	</section>

	<section class="card">
		<h2>Poslední změny</h2>
		<ul class="activity" n:if="$activity">
			<li n:foreach="$activity as $entry">
				<time>{$entry['created_at']|date:'j. n. H:i'}</time>
				{$entry['action']|eventLabel}
				<a n:if="$entry['reservation_id']" n:href="Reservation:detail $entry['reservation_id']">č. {$entry['reservation_id']}</a>
				<span class="muted">– {$entry['admin_name'] ?? 'systém'}</span>
			</li>
		</ul>
		<p n:if="!$activity" class="muted">Zatím žádné změny.</p>
	</section>
</div>
{/block}
