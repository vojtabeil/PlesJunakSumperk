{layout '@layout.html.latte'}
{varType array $reservation}
{varType array $settings}
{varType string $account}
{varType string $iban}
{varType string $qrCid}
{varType string $link}

{block content}
{var $seats = array_map(fn($label) => ($label|seatLabel), $reservation['seat_labels'])}
{var $rows = [
	'Číslo rezervace' => $reservation['id'],
	'Jméno' => $reservation['name'],
	'Místa u stolu' => $seats ? implode('; ', $seats) : '–',
	'Lístky bez místenky' => $reservation['standing_tickets'],
	'Celkem lístků' => count($seats) + (int) $reservation['standing_tickets'],
	'Kdy' => $settings['event_date'] ?? '',
	'Kde' => $settings['venue'] ?? '',
]}
<p>Dobrý den,</p>
<p>děkujeme za rezervaci lístků. Rezervaci jsme uložili:</p>
<table style="border-collapse:collapse;margin:16px 0">
	<tr n:foreach="$rows as $label => $value">
		<td style="padding:4px 16px 4px 0;color:#5c5c57">{$label}</td>
		<td style="padding:4px 0;font-weight:bold">{$value}</td>
	</tr>
</table>

<h2 style="margin:24px 0 8px;font-size:18px;color:#287234">Platba</h2>
<p>Zaplaťte prosím převodem{if $reservation['due_on']} <strong>do {$reservation['due_on']|date:'j. n. Y'}</strong>{/if},
	nejjednodušeji načtením QR kódu v aplikaci své banky:</p>
{include '@payment.html.latte'}
<p>Až platba dorazí, pošleme vám potvrzení. Lístky se netisknou – na vstupu vás najdeme na seznamu hostů.</p>
{/block}
