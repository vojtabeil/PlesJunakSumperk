<style>
html, body {
    margin: 0;
    padding: 0;
    font-family: sans-serif;
    text-align: center;
}

.ok {
    background-color: green;
    color: white;
}

.taken {
    background-color: red;
    color: white;
}

h1 {
    margin-top: 100px;
}
</style>

<body class="{=$letIn ? 'ok' : 'taken'}">
    <h1>{$chairId}</h1>
    <h2>email: {$email}</h2>
</body>