<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<title>Z lístky</title>
		<link rel="stylesheet" media="screen, print" href="{$baseUrl}/css/ticket.css">
	</head>

	<body>
		 {foreach $tickets as $ticket}
               
                <div class="ticket">
				<div class="number">#<strong>{=400+abs($ticket->id)}</strong></div>
				
				<div class="details{rand(1,4)}">
					<h3>Šumperský&nbsp;skautský&nbsp;ples&nbsp;2023 Z&mdash;lístek</h3>
					<h4>{$ticket->name}</h4>
					<table>
					<tr><th style="text-align: left !important;">Přípravy v pátek:</th><td>3. 2. 2023</td>	<td style="text-align: right !important;"><b>od 16:00 do 18:30</b></td></tr>
					<tr><th style="text-align: left !important;">Přípravy v sobotu dopoledne:</th><td>4. 2. 2023</td>		<td style="text-align: right !important;"><b>od 8:00 do 13:00</b></td></tr>
					<tr><th style="text-align: left !important;">Ples:</th><td>4. 2. 2023</td>		<td style="text-align: right !important;"><b>18:00</b></td></tr>
					<tr><th style="text-align: left !important;">Úklid v neděli:</th><td>5. 2. 2023</td>		<td style="text-align: right !important;"><b>8:00</b></td></tr>
					</table>
				</div>
				<div class="lilie">
					<img src="{$baseUrl}/img/skauting-me-bavi.png">
				</div>
			</div>
                {/foreach}
			
	</body>
</html>
