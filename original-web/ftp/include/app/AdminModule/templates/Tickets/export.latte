<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<title>Export pro tisk</title>
        <link rel="stylesheet" href="{$basePath}/admin/css/bootstrap.min.css">
		<style>
			.box {
				width: 20px;
				height: 20px;
				border: 2px solid #000;
				display: inline-block;
				margin: 0 auto;
			}
			
			td.center {
				text-align: center;
			}
			
			body {
				padding: 20px;
			}
		</style>
	</head>
	<body>
		<h1>Seznam zaplacených rezervací k {=date("j. n. Y H:i")}</h1>
		<table class="table table-condensed">
			<thead>
				<tr>
					<th>Jméno</th><th>Variabilní symbol</th><th>Email</th><th>Počet lístků</th><th>Jednotlivé lístky</th>
				</tr>
			</thead>
			<tbody>				
				{foreach $tickets as $ticket}
				<tr>
					<td>{$ticket->name}</td>
					<td>{= intval($ticket->variable_symbol)}</td>
					<td>{$ticket->email}</td>
					<td>{$ticket->count}</td>
					<td>
						{foreach $ticket->related("chair")->order("id") as $chair}
						<span class="box"></span> č. <strong>{$chair->id}</strong>{sep}<br>{/sep}
						{/foreach}
					</td>
				</tr>
				{/foreach}
			</tbody>
		</table>
	</body>
</html>